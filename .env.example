# =============================================================================
# Fidelis — environment variable template
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=fidelis_user
POSTGRES_PASSWORD=fidelis_dev_password
POSTGRES_DB=pr_reviewer

# Connection string for services running OUTSIDE Docker (e.g. local pytest).
# Inside Docker, each service constructs its own URL pointing at the
# postgres container via docker-compose environment vars.
DATABASE_URL=postgresql+psycopg://fidelis_user:fidelis_dev_password@localhost:5432/pr_reviewer

# ---------------------------------------------------------------------------
# Async processing (Redis + Celery)
# ---------------------------------------------------------------------------
ASYNC_REVIEW_ENABLED=true
WORKER_STATUS_TOKEN=fidelis-dev-worker-token-change-me
REVIEW_MAX_ATTEMPTS=3
REVIEWER_TIMEOUT_SECONDS=1400
REVIEW_WORKER_CONCURRENCY=1

# ---------------------------------------------------------------------------
# GitHub Webhook
# ---------------------------------------------------------------------------
# Set this to any random string for local dev; must match the secret
# configured in your GitHub webhook settings in production.
GITHUB_WEBHOOK_SECRET=dev_webhook_secret_change_me

# ---------------------------------------------------------------------------
# JWT (Gateway Service)
# ---------------------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_change_me_replace_in_production
JWT_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# Internal service URLs (used by gateway; overridden by compose env block)
# ---------------------------------------------------------------------------
WEBHOOK_SERVICE_URL=http://localhost:8002
ORCHESTRATOR_SERVICE_URL=http://localhost:8001

# ---------------------------------------------------------------------------
# Reviewer Service
# ---------------------------------------------------------------------------
# mock = deterministic demo; llm = local or hosted OpenAI-compatible provider.
# Local Windows Docker Desktop: run llama-server on the host, listening on 0.0.0.0:8080.
REVIEWER_MODE=llm
REVIEW_AGENTS=STATIC_ANALYSIS,SECURITY,ARCHITECTURE,CODE_STYLE
# sequential (recommended for one local GPU), single_pass (one combined model call), parallel (high-capacity inference only).
REVIEW_EXECUTION_STRATEGY=sequential
REVIEW_CHECKPOINTS_ENABLED=true
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=
LLM_MODEL=fidelis-deepseek14b
LLM_TIMEOUT_SECONDS=300
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
MAX_DIFF_CHARS=48000
MAX_SOURCE_CONTEXT_CHARS=12000
MAX_CONTEXT_FILES=6
SOURCE_CONTEXT_LINES=12
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
PUBLISH_GITHUB_REVIEWS=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# multi_agent | single_bug | clean | fail_retryable | fail_permanent | timeout | flaky
REVIEWER_MOCK_SCENARIO=multi_agent
# Artificial latency per review, in milliseconds (simulates a slow LLM).
REVIEWER_MOCK_DELAY_MS=0
# For the "flaky" scenario: failing attempts per job before it succeeds.
REVIEWER_MOCK_FLAKY_FAILURES=2

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENV=development

# Optional Langfuse v4 tracing. Disabled by default; never captures source diffs.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Alternative hosted provider: Google Gemini
# Copy these values into the existing .env when testing Gemini. Do not replace
# the rest of your secrets. See GEMINI-API-SETUP.md.
# ---------------------------------------------------------------------------
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=YOUR_GEMINI_API_KEY
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_REASONING_EFFORT=minimal
