# =============================================================================
# Fidelis — environment variable template
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=fidelis_user
POSTGRES_PASSWORD=fidelis_dev_password
POSTGRES_DB=pr_reviewer

# Connection string for services running OUTSIDE Docker (e.g. local pytest).
# Inside Docker, each service constructs its own URL pointing at the
# postgres container via docker-compose environment vars.
DATABASE_URL=postgresql+psycopg://fidelis_user:fidelis_dev_password@localhost:5432/pr_reviewer

# ---------------------------------------------------------------------------
# GitHub Webhook
# ---------------------------------------------------------------------------
# Set this to any random string for local dev; must match the secret
# configured in your GitHub webhook settings in production.
GITHUB_WEBHOOK_SECRET=dev_webhook_secret_change_me

# ---------------------------------------------------------------------------
# JWT (Gateway Service)
# ---------------------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_change_me
JWT_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# Internal service URLs (used by gateway; overridden by compose env block)
# ---------------------------------------------------------------------------
WEBHOOK_SERVICE_URL=http://localhost:8002
ORCHESTRATOR_SERVICE_URL=http://localhost:8001

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENV=development
