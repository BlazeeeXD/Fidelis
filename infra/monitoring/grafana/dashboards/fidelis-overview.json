    {"id": 2, "type": "stat", "title": "Queued", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "targets": [{"expr": "fidelis_review_jobs_queued", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Running", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "targets": [{"expr": "fidelis_review_jobs_running", "refId": "A"}]},
    {"id": 4, "type": "stat", "title": "Failed", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "targets": [{"expr": "fidelis_review_jobs_failed", "refId": "A"}]},
