# Gemini API override profile for Fidelis.
# Copy these values into your EXISTING .env; do not replace your real secrets.
# Create a Gemini API key at https://aistudio.google.com/apikey

REVIEWER_MODE=llm
REVIEW_AGENTS=STATIC_ANALYSIS,SECURITY,ARCHITECTURE,CODE_STYLE
REVIEW_EXECUTION_STRATEGY=sequential
REVIEW_CHECKPOINTS_ENABLED=true

# Google Gemini OpenAI-compatible Chat Completions endpoint.
# Flash-Lite fallback profile: lower cost and minimal default thinking.
# Return to gemini-3.8-flash + LLM_REASONING_EFFORT=low after API capacity stabilizes.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_REASONING_EFFORT=minimal

# Keep the existing GitHub configuration unchanged:
# GITHUB_TOKEN=...
# GITHUB_WEBHOOK_SECRET=...
# PUBLISH_GITHUB_REVIEWS=true
